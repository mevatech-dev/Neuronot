# Postgres connection — host-side string used by the api binary and goose.
# Local dev uses the compose-managed container (postgres/postgres/neuronot, hardcoded).
# Staging/prod: point this to the managed Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuronot

# JWT signing — must be ≥32 characters.
# Generate a real one for staging/prod via: openssl rand -hex 32
JWT_SECRET=neuronot_dev_jwt_secret_minimum_32_chars_long

# OpenAI API key — required for /v1/insights/generate (Hafta 3+).
# Without this, the insight endpoint returns a 503; the rest of the API still boots.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# HTTP
PORT=8080
LOG_LEVEL=info

# CONSENT_KEK is a 32-byte AES-256 master key used to encrypt audit fields
# (IP, device id) on the consents table. Must decode (base64) to exactly 32 bytes.
# DEV-ONLY default below — REGENERATE for any non-local environment via:
#   openssl rand -base64 32
# Without this env, the API refuses to boot.
CONSENT_KEK=ZGV2X25ldXJvbm90X2NvbnNlbnRfa2VrX29ubHlfMzI=

# Sign in with Apple — single audience (your iOS bundle id).
# Empty disables the /v1/auth/apple endpoint (it returns 503 when called).
APPLE_BUNDLE_ID=

# Sign in with Google — comma-separated list of allowed OAuth client ids
# (iOS, Android, Expo client). Empty disables the /v1/auth/google endpoint.
# Example: GOOGLE_OAUTH_AUDIENCES=ios.apps.googleusercontent.com,android.apps.googleusercontent.com
GOOGLE_OAUTH_AUDIENCES=
