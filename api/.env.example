# Postgres connection
DATABASE_URL=postgres://neuronot:neuronot_dev@localhost:5432/neuronot?sslmode=disable

# JWT signing — generate via: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_string

# OpenAI API key — required for /v1/insights/generate
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# HTTP
PORT=8080
LOG_LEVEL=info

# CONSENT_KEK is a 32-byte AES-256 master key used to encrypt audit fields
# (IP, device id) on the consents table. Generate locally with:
#   openssl rand -base64 32
# Without this env, the API refuses to boot.
CONSENT_KEK=

# Sign in with Apple — single audience (your iOS bundle id). Empty disables
# the /v1/auth/apple endpoint (it returns 503 when called).
APPLE_BUNDLE_ID=

# Sign in with Google — comma-separated list of allowed OAuth client ids
# (iOS, Android, Expo client). Empty disables the /v1/auth/google endpoint.
# Example: GOOGLE_OAUTH_AUDIENCES=ios.apps.googleusercontent.com,android.apps.googleusercontent.com
GOOGLE_OAUTH_AUDIENCES=
